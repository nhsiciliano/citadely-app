---
import Calculator from "@lucide/astro/icons/calculator";
import CarFront from "@lucide/astro/icons/car-front";
import Dumbbell from "@lucide/astro/icons/dumbbell";
import FaceSlightlySmilingPlus from "@lucide/astro/icons/face-slightly-smiling-plus";
import Landmark from "@lucide/astro/icons/landmark";
import Sparkles from "@lucide/astro/icons/sparkles";
import Stethoscope from "@lucide/astro/icons/stethoscope";
import Volleyball from "@lucide/astro/icons/volleyball";

const INDUSTRIES = [
  { name: "Consultorios clínicos", icon: Stethoscope },
  { name: "Centros odontológicos", icon: FaceSlightlySmilingPlus },
  { name: "Oficinas gubernamentales", icon: Landmark },
  { name: "Estudios contables", icon: Calculator },
  { name: "Gimnasios", icon: Dumbbell },
  { name: "Escuelas de conducción", icon: CarFront },
  { name: "Alquiler de canchas", icon: Volleyball },
  { name: "Centros de estética", icon: Sparkles },
];
---

<section aria-labelledby="rubros-title" class="border-y border-line bg-canvas" id="rubros">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-balance text-3xl font-semibold tracking-[-0.035em] text-navy sm:text-5xl" id="rubros-title">Una central para distintos tipos de turnos.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-pretty leading-7 text-ink-soft">Configuralo según los servicios, precios, señas y horarios de tu negocio. La estructura operativa se mantiene clara en cualquier rubro.</p>
    </div>
    <ul class="mx-auto mt-12 grid max-w-5xl grid-cols-2 gap-x-5 gap-y-10 sm:mt-16 sm:gap-x-8 sm:gap-y-12 lg:grid-cols-4">
      {
        INDUSTRIES.map(({ name, icon: Icon }) => (
          <li class="flex min-w-0 flex-col items-center gap-4 text-center">
            <span class="grid h-16 w-16 shrink-0 place-items-center rounded-md bg-white text-primary">
              <Icon aria-hidden="true" size={32} stroke-width={1.75} />
            </span>
            <span class="min-h-12 max-w-44 text-balance text-sm font-semibold leading-6 text-navy sm:text-base">{name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
