---
// Port of MarketingFooter in components/marketing-shell.tsx.
import { LEGAL_PATHS } from "../lib/site";
---

<footer class="border-t border-white/10 bg-navy text-white">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-5 px-5 py-8 text-sm sm:px-8 md:flex-row md:items-center md:justify-between lg:px-12">
    <span class="font-semibold">Citadely</span>
    <p class="text-white/65">Central de turnos para negocios de servicios.</p>
    <nav aria-label="Enlaces del footer" class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <a class="text-white/70 hover:text-white" href="mailto:contacto@citadely.com.ar">contacto@citadely.com.ar</a>
      <a class="text-white/70 hover:text-white" href="/blog">Blog</a>
      <a class="text-white/70 hover:text-white" href="/login">Ingresar</a>
      <a class="text-white/70 hover:text-white" href="/registro">Crear cuenta</a>
      <a class="text-white/70 hover:text-white" href={LEGAL_PATHS.privacy}>Política de privacidad</a>
      <a class="text-white/70 hover:text-white" href={LEGAL_PATHS.terms}>Condiciones del servicio</a>
      <a aria-label="Citadely en Instagram (@citadely.ar)" class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-white/70 hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" href="https://www.instagram.com/citadely.ar/" rel="noopener noreferrer" target="_blank">
        <svg aria-hidden="true" class="h-[21px] w-[21px]" fill="none" viewBox="0 0 24 24">
          <rect height="18" rx="5" stroke="currentColor" stroke-width="1.8" width="18" x="3" y="3" />
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
          <circle cx="17.5" cy="6.5" fill="currentColor" r="1.1" />
        </svg>
      </a>
    </nav>
  </div>
</footer>
