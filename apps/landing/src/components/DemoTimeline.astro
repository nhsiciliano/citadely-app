---
// Static sample day shown in the hero; the data is fictitious.
const TIMELINE = [
  { time: "09:00", service: "Consulta inicial", client: "Luciana Martínez", state: "Confirmado", tone: "success" },
  { time: "10:30", service: "Corte + color", client: "Camila Fernández", state: "Confirmado", tone: "success" },
  { time: "12:00", service: "Manicura semipermanente", client: "Julieta Rojas", state: "Seña pendiente", tone: "warning" },
  { time: "14:00", service: "Reserva desde tu web", client: "Facundo Pérez", state: "Nuevo", tone: "primary" },
] as const;

const BADGE_CLASS = {
  success: "status-confirmed",
  warning: "status-pending_payment",
  primary: "bg-primary-soft text-primary",
} as const;
---

<figure class="mx-auto w-full max-w-[610px]">
  <div class="relative pl-11 sm:pl-16">
    <span aria-hidden="true" class="absolute bottom-7 left-[18px] top-4 w-px bg-primary sm:left-[30px]"></span>
    <span class="absolute left-0 top-0 grid h-9 min-w-9 place-items-center rounded-full bg-primary px-2 font-mono text-[10px] font-bold text-white sm:left-3">HOY</span>
    <div class="grid gap-3">
      {
        TIMELINE.map((item, index) => (
          <div class="relative grid grid-cols-[54px_minmax(0,1fr)] items-start gap-3">
            <span
              aria-hidden="true"
              class:list={[
                "absolute -left-[34px] top-6 h-3 w-3 rounded-full border-[3px] border-white ring-2 sm:-left-[40px]",
                index === TIMELINE.length - 1 ? "bg-primary ring-primary" : "bg-white ring-primary",
              ]}
            ></span>
            <time class="pt-4 font-mono text-xs font-semibold text-ink-soft">{item.time}</time>
            <div class="border border-line bg-white p-4 shadow-surface">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-sm font-semibold">{item.service}</p>
                  <p class="mt-1 text-xs text-ink-soft">{item.client}</p>
                </div>
                <span class:list={["status-badge", BADGE_CLASS[item.tone]]}>{item.state}</span>
              </div>
              {item.tone === "warning" && (
                <div class="mt-3 flex items-center justify-between border-t border-line pt-3 text-xs">
                  <span class="text-warning">Seña $8.000</span>
                  <span class="font-semibold text-primary">Revisar reserva</span>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <figcaption class="mt-5 text-right text-xs text-ink-muted">Ejemplo de jornada · datos ficticios</figcaption>
</figure>
