{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mercadopago-mcp-server": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "exec npx -y mcp-remote https://mcp.mercadopago.com/mcp --header \"Authorization: Bearer ${MERCADOPAGO_ACCESS_TOKEN}\""
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
