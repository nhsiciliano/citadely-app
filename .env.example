# Copiar a .env.local y completar. Nunca commitear valores reales.
# Cada variable indica dónde se usa: [Prod+Preview] = ambos entornos de Vercel,
# [Preview] = solo entorno Preview / desarrollo local, [Local] = solo scripts, tests o mocks.

# --- InsForge (backend) ---
NEXT_PUBLIC_INSFORGE_BASE_URL=https://3v48rhzn.us-east.insforge.app   # [Prod+Preview]
NEXT_PUBLIC_INSFORGE_ANON_KEY=                                          # [Prod+Preview]
INSFORGE_API_KEY=                                                       # [Prod+Preview] clave de servicio, solo servidor

# --- Dominio y URLs ---
NEXT_PUBLIC_APP_DOMAIN=citadely.com.ar                                  # [Prod+Preview] dominio base para subdominios de negocios
APP_BASE_URL=https://www.citadely.com.ar                                # [Prod+Preview] origen usado en emails y en el checkout de Mercado Pago
NEXT_PUBLIC_APP_URL=                                                    # [Local/Preview] fallback de APP_BASE_URL. Ej.: http://localhost:3000
GOOGLE_SITE_VERIFICATION=                                               # [Prod+Preview] meta de verificación de Search Console (opcional)

# --- Email (Resend) ---
RESEND_API_KEY=                                                         # [Prod+Preview]
RESEND_FROM_EMAIL=notificaciones@citadely.com.ar                        # [Prod+Preview]
RESEND_WEBHOOK_SECRET=                                                  # [Prod+Preview]
RESEND_CONTACT_FORWARD_TO=                                              # [Prod+Preview] destino del formulario de contacto (opcional)
RESEND_SKIP_DELIVERY=false                                              # [Preview] "true" no envía emails; en Production debe estar sin definir o en false (lib/env.ts falla si es true)

# --- Mercado Pago (suscripción mensual de negocios) ---
MERCADOPAGO_ACCESS_TOKEN=                                               # [Prod+Preview] TEST- en Preview; en Production no puede empezar con TEST- (lib/env.ts)
MERCADOPAGO_WEBHOOK_SECRET=                                             # [Prod+Preview]
MERCADOPAGO_PAYER_EMAIL=                                                # [Preview] pagador de prueba de MP; se ignora cuando VERCEL_ENV=production
MERCADOPAGO_API_BASE_URL=                                               # [Local] mock de E2E (http://127.0.0.1:3010). Omitir para usar https://api.mercadopago.com

# --- Cron y panel editorial privado ---
CRON_SECRET=                                                            # [Prod+Preview] Bearer que Vercel Cron envía a /api/cron/*
ADMIN_USERNAME=admin                                                    # [Prod+Preview]
ADMIN_PASSWORD_HASH=                                                    # [Prod+Preview] hash scrypt generado para el panel
ADMIN_SESSION_SECRET=                                                   # [Prod+Preview] secreto HMAC de la sesión del panel

# --- Vercel ---
VERCEL_AUTOMATION_BYPASS_SECRET=                                        # [Preview] bypass de Deployment Protection para el webhook de MP; se ignora en Production

# --- Tests E2E (Playwright) ---
E2E_ADMIN_PASSWORD=                                                     # [Local] contraseña del panel editorial usada por tests/e2e
CITADELY_DEMO_EMAIL=                                                    # [Local] escrito por `pnpm seed:demo` en .env.local
CITADELY_DEMO_PASSWORD=                                                 # [Local] escrito por `pnpm seed:demo` en .env.local
RUN_PROMO_REDEMPTION=                                                   # [Local] "1" habilita la prueba de canje de promo (escribe datos; solo contra Preview)

# --- Seeds de datos de demo (solo escritura en backend branch de Preview) ---
# Seeds y E2E escriben solo en un backend branch (tiene branched_from). Si no hay terminal interactiva,
# confirmar con el nombre exacto del proyecto enlazado.
SEED_CONFIRM_PROJECT=                                                   # [Local] project_name del backend branch, ej. feature-functionalities-improves
SEED_BARBERIA_LUK_EMAIL=                                                # [Local] requerido por `pnpm seed:barberia-luk`
SEED_BARBERIA_LUK_PASSWORD=                                             # [Local] requerido por `pnpm seed:barberia-luk`
SEED_CLINICA_COLON_EMAIL=                                               # [Local] requerido por `pnpm seed:clinica-colon`
SEED_CLINICA_COLON_PASSWORD=                                            # [Local] requerido por `pnpm seed:clinica-colon`

# --- Observabilidad (opcional; sin DSN, Sentry no se carga y los errores van a console.error) ---
SENTRY_DSN=                                                             # [Prod+Preview] DSN de Sentry (servidor)
NEXT_PUBLIC_SENTRY_DSN=                                                 # [Prod+Preview] DSN de Sentry (navegador)
SENTRY_TRACES_SAMPLE_RATE=0.05                                          # [Prod+Preview] opcional, 0 a 1

# --- Anti-bot en la reserva pública (opcional) ---
PUBLIC_BOOKING_HASH_SECRET=                                             # [Prod+Preview] clave HMAC para hashear IPs en public_booking_attempts (default: INSFORGE_API_KEY)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                                         # [Prod+Preview] Cloudflare Turnstile; definir junto con TURNSTILE_SECRET_KEY o ninguna
TURNSTILE_SECRET_KEY=                                                   # [Prod+Preview] si está definida, /api/public-booking exige el token
