RESEND_SKIP_DELIVERY=false
RESEND_CONTACT_FORWARD_TO=

# Mercado Pago para suscripcion mensual de negocios
# En produccion no puede empezar con TEST-.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Solo Preview/local: se ignora cuando VERCEL_ENV=production.
MERCADOPAGO_PAYER_EMAIL=
# Solo Preview: bypass de Deployment Protection para el webhook de MP. Se ignora en produccion.
VERCEL_AUTOMATION_BYPASS_SECRET=
CRON_SECRET=

# Panel editorial privado (solo servidor; configurar por rama Preview)
